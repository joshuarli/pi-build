+import { isIP } from "node:net";
+import { isAbsolute } from "node:path";
+import { closeSync, constants, fstatSync, openSync, readFileSync } from "node:fs";
+
+export interface RemoteTcpTarget {
+  transport: "tcp";
+  host: string;
+  port: number;
+}
+
+export type RemoteBrokerTarget = string | RemoteTcpTarget;
+
+const ENDPOINT_ENV = "AGENT_INTERCOM_REMOTE_ENDPOINT";
+const CREDENTIAL_ENV = "AGENT_INTERCOM_ACCESS_CREDENTIAL_PATH";
+const LISTEN_ENV = "AGENT_INTERCOM_REMOTE_LISTEN";
+
+export function isRemoteBrokerConfigured(env: NodeJS.ProcessEnv = process.env): boolean {
+  // An explicitly empty value is a configuration error, never local fallback.
+  return env[ENDPOINT_ENV] !== undefined;
+}
+
+function isTailnetAddress(host: string): boolean {
+  if (isIP(host) === 4) {
+    const bytes = host.split(".").map(Number);
+    return bytes[0] === 100 && bytes[1] >= 64 && bytes[1] <= 127;
+  }
+  return isIP(host) === 6 && /^fd7a:115c:a1e0:/i.test(host);
+}
+
+export function parseRemoteBrokerTarget(value: string, setting = ENDPOINT_ENV): RemoteBrokerTarget {
+  if (!value || value !== value.trim() || /[\u0000-\u0020\u007f]/.test(value)) {
+    throw new Error(`${setting} must be a nonempty endpoint without whitespace`);
+  }
+  let endpoint: URL;
+  try {
+    endpoint = new URL(value);
+  } catch {
+    throw new Error(`${setting} must be tcp://<tailnet-IP>:<port> or unix:///absolute/socket`);
+  }
+  if (endpoint.username || endpoint.password || endpoint.search || endpoint.hash) {
+    throw new Error(`${setting} cannot contain credentials, query parameters, or fragments`);
+  }
+  if (endpoint.protocol === "unix:") {
+    if (!value.startsWith("unix:///") || endpoint.host) {
+      throw new Error(`${setting} requires an absolute Unix socket path`);
+    }
+    let path: string;
+    try {
+      path = decodeURIComponent(endpoint.pathname);
+    } catch {
+      throw new Error(`${setting} contains an invalid encoded socket path`);
+    }
+    if (!isAbsolute(path) || path === "/" || path.endsWith("/") || /[\u0000-\u001f\u007f]/.test(path)) {
+      throw new Error(`${setting} requires an absolute Unix socket file path`);
+    }
+    return path;
+  }
+  const host = endpoint.hostname.replace(/^\[|\]$/g, "");
+  const port = Number(endpoint.port);
+  if (endpoint.protocol !== "tcp:" || endpoint.pathname || !isTailnetAddress(host)
+      || !/^[0-9]+$/.test(endpoint.port) || !Number.isInteger(port) || port < 1 || port > 65535) {
+    throw new Error(`${setting} must use a literal Tailscale 100.64.0.0/10 or fd7a:115c:a1e0::/48 address and port 1–65535`);
+  }
